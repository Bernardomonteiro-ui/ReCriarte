---
import Frame from '@/components/ui/Frame.astro';
import Line from '@/components/motion/Line.astro';
import { projects, categoryLabel } from '@/data/portfolio';

const layout = ['big', 'tall', 'wide', 'big2'] as const;
const ratios = { big: '16/11', tall: '3/4', wide: '16/9', big2: '4/3' };
const tones = ['mist', 'navy', 'white', 'mist'] as const;
const items = projects.slice(0, 4);
---

<section class="pf section" id="trabalhos" aria-labelledby="pf-title">
  <div class="container">
    <header class="pf-head">
      <h2 id="pf-title" class="pf-title" data-split>
        <Line>Feito para durar.</Line>
        <Line>Pensado para você.</Line>
      </h2>
    </header>

    <ul class="pf-grid" role="list">
      {items.map((p, i) => (
        <li class:list={['pf-item', `pf-item--${layout[i]}`]}>
          <a href={`/trabalhos#${p.id}`} class="pf-link" data-cursor-target data-project={p.id}>
            <span class="pf-num" aria-hidden="true">0{i + 1}</span>
            <div class="pf-media" data-reveal="clip">
              <div class="pf-zoom" data-parallax="0.08">
                <Frame photo={p.cover.photo} alt={`${p.title} — ${categoryLabel(p.category)}`} art={p.cover.art} tone={tones[i]} ratio={ratios[layout[i]]} sizes="(min-width: 900px) 60vw, 100vw" />
              </div>
            </div>
            <div class="pf-meta">
              <h3 class="pf-name">{p.title}</h3>
              <span class="tech pf-cat">{categoryLabel(p.category)}</span>
            </div>
            <p class="pf-sum">{p.summary}</p>
          </a>
        </li>
      ))}
    </ul>

    <div class="pf-foot">
      <a href="/trabalhos" class="btn btn--ghost">Ver todos os trabalhos</a>
    </div>
  </div>
</section>

<style>
  .pf-head { margin-bottom: clamp(48px, 6vw, 96px); }
  .pf-title { font-size: var(--fs-3xl); letter-spacing: -0.05em; }
  .pf-title .serif { font-weight: 400; }

  .pf-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 32px); row-gap: clamp(48px, 6vw, 96px); }
  .pf-item--big { grid-column: 1 / span 8; }
  .pf-item--tall { grid-column: 9 / span 4; margin-top: 18%; }
  .pf-item--wide { grid-column: 1 / span 7; }
  .pf-item--big2 { grid-column: 8 / span 5; margin-top: 22%; }

  .pf-link { display: grid; gap: 14px; position: relative; }
  .pf-num {
    position: absolute; z-index: 3; top: 0; left: 0;
    font-family: var(--serif); font-style: italic; font-weight: 400;
    font-size: clamp(2.4rem, 4.4vw, 4.4rem); line-height: 1;
    color: var(--ink); background: var(--paper);
    padding: 0.1em 0.28em 0.05em 0;
    pointer-events: none;
  }
  .pf-item--tall .pf-num, .pf-item--big2 .pf-num { left: auto; right: 0; padding: 0.1em 0 0.05em 0.28em; }
  .pf-media { overflow: hidden; position: relative; }
  .pf-zoom { transition: transform 1.2s var(--ease-out); }
  .pf-zoom :global(.frame) { transition: transform 1.2s var(--ease-out); }
  .pf-link:hover .pf-zoom :global(.frame) { transform: scale(1.05); }
  .pf-media::after { content: ''; position: absolute; inset: 0; background: var(--yellow); mix-blend-mode: multiply; opacity: 0; transition: opacity 0.6s; pointer-events: none; }
  .pf-link:hover .pf-media::after { opacity: 0.12; }

  .pf-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line-strong); padding-bottom: 12px; }
  .pf-name { font-size: var(--fs-xl); letter-spacing: -0.04em; transition: transform 0.6s var(--ease-out); }
  .pf-link:hover .pf-name { transform: translateX(10px); }
  .pf-cat { color: var(--gray); }
  .pf-sum { color: var(--ink-soft); max-width: 46ch; font-size: var(--fs-sm); }
  .pf-foot { margin-top: clamp(48px, 6vw, 96px); display: flex; justify-content: center; }

  @media (max-width: 900px) {
    .pf-grid { grid-template-columns: repeat(6, 1fr); }
    .pf-item--big { grid-column: 1 / -1; }
    .pf-item--tall { grid-column: 2 / -1; margin-top: 0; }
    .pf-item--wide { grid-column: 1 / -1; margin-top: 0; }
    .pf-item--big2 { grid-column: 1 / span 5; margin-top: 0; }
  }
</style>

<script>
  import { track } from '@/utils/track';
  document.querySelectorAll<HTMLAnchorElement>('[data-project]').forEach((a) =>
    a.addEventListener('click', () => track('portfolio_project_viewed', { project: a.dataset.project ?? '', from: 'home' })),
  );
</script>
