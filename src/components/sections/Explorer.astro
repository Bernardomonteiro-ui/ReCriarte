---
/**
 * Explorador "sintoma → o que fazemos". Lista à esquerda; desenho/foto à direita
 * troca ao passar, focar ou tocar. Não depende de hover.
 */
import Frame from '@/components/ui/Frame.astro';
import Line from '@/components/motion/Line.astro';
import type { Art } from '@/utils/types';

export interface ExplorerItem { title: string; symptom: string; solution: string; art: Art; photo?: string }
interface Props { eyebrow: string; title: string; accent: string; items: ExplorerItem[]; id?: string }
const { eyebrow, title, accent, items, id = 'explorer' } = Astro.props;
---

<section class="ex section" aria-labelledby={`${id}-title`} data-explorer>
  <div class="container">
    <header class="ex-head">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h2 id={`${id}-title`} class="ex-title" data-split>
        <Line>{title}</Line>
        <Line><span class="serif">{accent}</span></Line>
      </h2>
    </header>

    <div class="ex-grid">
      <ol class="ex-list" role="list">
        {items.map((it, i) => (
          <li>
            <button type="button" class:list={['ex-item', { 'is-on': i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} data-ex={i}>
              <span class="ex-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="ex-body">
                <span class="ex-t">{it.title}</span>
                <span class="ex-s"><span class="ex-in"><span class="tech">Sintoma</span> {it.symptom}</span></span>
                <span class="ex-f"><span class="ex-in"><span class="tech">O que fazemos</span> {it.solution}</span></span>
              </span>
            </button>
          </li>
        ))}
      </ol>
      <div class="ex-media" aria-hidden="true">
        {items.map((it, i) => (
          <div class:list={['ex-slide', { 'is-on': i === 0 }]} data-ex-slide={i}>
            <Frame photo={it.photo} alt={it.title} art={it.art} tone={i % 2 ? 'mist' : 'navy'} refCode={`${String(i + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`} caption={it.title} sizes="(min-width: 900px) 45vw, 100vw" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ex-head { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 24px; margin-bottom: clamp(40px, 5vw, 80px); }
  .ex-head .eyebrow { padding-top: 1.2em; }
  .ex-title { font-size: var(--fs-2xl); letter-spacing: -0.045em; }
  .ex-title .serif { font-weight: 400; }
  .ex-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(32px, 5vw, 88px); align-items: start; }
  .ex-list { border-top: 1px solid var(--line-strong); }
  .ex-item {
    width: 100%; text-align: left;
    display: grid; grid-template-columns: 44px 1fr; gap: 12px;
    padding: 22px 0; border-bottom: 1px solid var(--line-strong);
    position: relative;
  }
  .ex-item::before { content: ''; position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: var(--yellow); transform: scaleX(0); transform-origin: left; transition: transform 0.6s var(--ease-out); }
  .ex-item.is-on::before { transform: scaleX(1); }
  .ex-n { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.14em; color: var(--gray); padding-top: 0.5em; }
  .ex-body { display: grid; gap: 0; }
  .ex-t { font-size: var(--fs-lg); font-weight: 800; letter-spacing: -0.03em; transition: transform 0.5s var(--ease-out); }
  .ex-item.is-on .ex-t { transform: translateX(8px); }
  .ex-s, .ex-f { display: grid; grid-template-rows: 0fr; overflow: hidden; color: var(--ink-soft); font-size: var(--fs-sm); transition: grid-template-rows 0.6s var(--ease-out), margin 0.6s var(--ease-out); }
  .ex-in { min-height: 0; overflow: hidden; display: block; }
  .ex-s .tech, .ex-f .tech { display: block; color: var(--gray); margin-bottom: 2px; font-size: 10px; }
  .ex-item.is-on .ex-s, .ex-item.is-on .ex-f { grid-template-rows: 1fr; margin-top: 12px; }
  .ex-media { position: sticky; top: 100px; aspect-ratio: 4 / 4.4; }
  .ex-slide { position: absolute; inset: 0; clip-path: inset(0 0 100% 0); transition: clip-path 0.9s var(--ease-in-out); }
  .ex-slide.is-on { clip-path: inset(0 0 0 0); z-index: 2; }
  .ex-slide :global(.frame) { width: 100%; height: 100%; }
  @media (max-width: 900px) {
    .ex-head, .ex-grid { grid-template-columns: 1fr; }
    .ex-head .eyebrow { padding-top: 0; }
    .ex-media { position: relative; top: 0; order: -1; aspect-ratio: 4 / 3.4; }
    .ex-grid { gap: 24px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLButtonElement>('[data-ex]')];
    const slides = [...root.querySelectorAll<HTMLElement>('[data-ex-slide]')];
    const fine = window.matchMedia('(hover: hover)');
    const set = (i: number) => {
      items.forEach((b, k) => { b.classList.toggle('is-on', k === i); b.setAttribute('aria-pressed', String(k === i)); });
      slides.forEach((s, k) => s.classList.toggle('is-on', k === i));
    };
    items.forEach((b, i) => {
      b.addEventListener('click', () => set(i));
      b.addEventListener('focus', () => set(i));
      b.addEventListener('pointerenter', () => { if (fine.matches) set(i); });
    });
  });
</script>
