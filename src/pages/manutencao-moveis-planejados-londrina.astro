---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Line from '@/components/motion/Line.astro';
import Explorer from '@/components/sections/Explorer.astro';
import BeforeAfter from '@/components/before-after/BeforeAfter.astro';
import Process from '@/components/process/Process.astro';
import Faq from '@/components/sections/Faq.astro';
import RelatedServices from '@/components/sections/RelatedServices.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { maintenanceFaq } from '@/data/faq';
import { faq, service, breadcrumbs } from '@/utils/schema';
import { whatsappUrl, messages } from '@/utils/whatsapp';

const site = Astro.site!;
const path = '/manutencao-moveis-planejados-londrina';
const crumbs = [{ name: 'Início', href: '/' }, { name: 'Manutenção', href: path }];
const description =
  'Conserto de armário planejado em Londrina: regulagem de portas, troca de corrediça de gaveta, pistão de armário aéreo, puxadores e fita de borda.';

const items = [
  { title: 'Regular porta de armário e trocar dobradiça', symptom: 'A porta não fecha, fica torta, raspa na outra ou caiu.', solution: 'Regulagem de altura, lateral e profundidade — ou troca da dobradiça quando ela já cedeu.', art: { kind: 'drawing', name: 'hinge' } as const, photo: 'manutencao/dobradica.jpg' },
  { title: 'Troca de corrediça de gaveta', symptom: 'A gaveta pesa, trava, sai do trilho ou não fecha até o fim.', solution: 'Ajuste ou troca das corrediças e alinhamento da frente da gaveta.', art: { kind: 'drawing', name: 'slide' } as const, photo: 'manutencao/corredica.jpg' },
  { title: 'Trocar pistão de armário aéreo', symptom: 'A porta do aéreo não para aberta ou desce sozinha.', solution: 'Troca do pistão e regulagem da porta basculante.', art: { kind: 'drawing', name: 'piston' } as const, photo: 'manutencao/pistao.jpg' },
  { title: 'Troca e fixação de puxadores', symptom: 'Puxador solto, quebrado ou que você quer trocar.', solution: 'Fixação ou substituição, respeitando a furação existente sempre que possível.', art: { kind: 'drawing', name: 'handle' } as const, photo: 'manutencao/puxador.jpg' },
  { title: 'Fita de borda descolando', symptom: 'A fita do acabamento descolou, levantou ou quebrou.', solution: 'Recolagem ou substituição da fita de borda.', art: { kind: 'drawing', name: 'edge' } as const, photo: 'manutencao/fita-de-borda.jpg' },
  { title: 'Porta de correr pesada ou fora do trilho', symptom: 'Pesada, barulhenta, travando ou fora do trilho.', solution: 'Ajuste de roldanas e trilhos para a porta voltar a deslizar.', art: { kind: 'planejado', mode: 'line', dims: true } as const, photo: 'manutencao/porta-de-correr.jpg' },
];
---

<BaseLayout
  title="Conserto e manutenção de planejados em Londrina"
  description={description}
  serviceId="manutencao"
  schema={[
    service(site, { name: 'Manutenção de móveis planejados em Londrina', serviceType: 'Assistência técnica de móveis planejados', description, path }),
    faq(maintenanceFaq),
    breadcrumbs(site, crumbs),
  ]}
>
  <PageHero
    crumbs={crumbs}
    lead="Porta caída, gaveta travando, basculante que não para aberto. Na maioria das vezes, o seu planejado não precisa ser trocado — precisa de ajuste, ferragem nova e cuidado."
    art={{ kind: 'drawing', name: 'hinge' }}
    photo="manutencao/hero.jpg"
    imageAlt="Detalhe técnico de dobradiça com pontos de regulagem"
    refCode="Regulagem de dobradiça"
    ctaLabel="Preciso consertar meu móvel"
    ctaHref={whatsappUrl(messages.service('manutenção'))}
    secondaryLabel="Fazer o diagnóstico"
    secondaryHref="/#diagnostico"
  >
    <Fragment slot="title">
      <Line>Manutenção de</Line>
      <Line>móveis planejados</Line>
      <Line>em Londrina</Line>
    </Fragment>
  </PageHero>

  <Explorer
    id="mt"
    title="Cada sintoma tem"
    accent="uma causa — e um conserto."
    items={items}
  />

  <section class="section mt-seo" aria-labelledby="mt-seo-t">
    <div class="container mt-seo-in">
      <h2 id="mt-seo-t" class="mt-h">Conserto de armário planejado, sem trocar o móvel</h2>
      <div class="mt-seo-txt">
        <p>
          A maior parte dos problemas de um móvel planejado está nas peças que se movem: dobradiças, corrediças, pistões, trilhos e puxadores.
          Elas trabalham todos os dias e, com o tempo, cedem, desregulam ou quebram. A estrutura do móvel — as chapas, a caixa, o acabamento — normalmente continua boa.
        </p>
        <p>
          É por isso que a manutenção resolve tanto: regular uma porta, trocar a corrediça de uma gaveta ou o pistão de um armário aéreo devolve o funcionamento do móvel sem precisar trocá-lo.
          A ReCriarte faz esse trabalho de assistência técnica para móveis planejados em Londrina.
        </p>
        <p>
          Se o móvel está bom mas não serve mais para a sua rotina, veja a <a href="/adaptacao-moveis-planejados">adaptação de móveis planejados</a>.
          Se falta uma peça, conheça as <a href="/moveis-sob-medida-londrina">peças sob medida</a>. E se não sabe por onde começar, <a href="/#diagnostico">faça o diagnóstico</a> e mande pelo WhatsApp.
        </p>
      </div>
    </div>
  </section>

  <section class="section" data-theme="mist" aria-labelledby="mt-ba">
    <div class="container">
      <h2 id="mt-ba" class="mt-h" data-split>
        <Line>Antes de trocar,</Line>
        <Line>regule.</Line>
      </h2>
      <p class="lead mt-lead">Uma porta fora do lugar dá a impressão de móvel velho. Às vezes, alguns minutos de regulagem mudam tudo.</p>
      <div data-reveal="clip"><BeforeAfter id="manutencao" before="manutencao/antes.jpg" after="manutencao/depois.jpg" /></div>
    </div>
  </section>

  <Process />
  <Faq items={maintenanceFaq} title="Manutenção: dúvidas comuns" />
  <RelatedServices current="manutencao" />
  <FinalCta />
</BaseLayout>

<style>
  .mt-h { font-size: var(--fs-2xl); letter-spacing: -0.045em; }
  .mt-h :global(.serif) { font-weight: 400; }
  .mt-seo-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 96px); align-items: start; }
  .mt-seo .mt-h { font-size: var(--fs-xl); letter-spacing: -0.035em; }
  .mt-seo-txt { display: grid; gap: 18px; max-width: 66ch; color: var(--ink-soft); font-size: var(--fs-md); }
  .mt-seo-txt a { color: var(--navy); font-weight: 700; text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: 3px; text-underline-offset: 3px; }
  @media (max-width: 900px) { .mt-seo-in { grid-template-columns: 1fr; } }
  .mt-lead { margin: 20px 0 clamp(32px, 4vw, 56px); }
</style>
