---
import Line from '@/components/motion/Line.astro';
import { company } from '@/config/company';
import { whatsappUrl, messages } from '@/utils/whatsapp';
interface Props { secondaryHref?: string }
const { secondaryHref = '/#diagnostico' } = Astro.props;
---

<section class="fc" data-theme="navy" aria-labelledby="fc-title" data-hide-mcta>
  <div class="container">
    <h2 id="fc-title" class="fc-title" data-split>
      <Line>Seu móvel tem</Line>
      <Line>um problema.</Line>
      <Line><span class="serif hl">A gente tem</span></Line>
      <Line><span class="serif hl">um caminho.</span></Line>
    </h2>

    <div class="fc-row">
      <div class="fc-ctas" data-reveal>
        <a href="/orcamento" class="btn fc-btn">Pedir orçamento <span class="arrow" aria-hidden="true">→</span></a>
        <a href={secondaryHref} class="btn btn--ghost fc-btn">Descobrir o problema <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <dl class="fc-info" data-reveal data-delay="0.1">
        <div><dt class="tech">Onde</dt><dd>{company.cityLabel}</dd></div>
        <div><dt class="tech">WhatsApp</dt><dd><a href={whatsappUrl(messages.default)} target="_blank" rel="noopener" data-wa="final-cta">{company.phoneDisplay || 'Chamar agora'} ↗</a></dd></div>
        {company.hours.length > 0 && (
          <div><dt class="tech">Horários</dt><dd>{company.hours.map((h) => <span>{h.days} · {h.hours}</span>)}</dd></div>
        )}
      </dl>
    </div>
  </div>
</section>

<style>
  .fc { padding: clamp(112px, 14vw, 220px) 0 clamp(72px, 8vw, 120px); position: relative; overflow: hidden; }
  .fc::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, transparent calc(100% - 1px), var(--line) 0) 0 0 / calc(100% / 12) 100%;
    opacity: 0.6;
  }
  .fc .container { position: relative; }
  .fc-title { font-size: var(--fs-mega); letter-spacing: -0.06em; line-height: 0.9; }
  .fc-title .serif { font-weight: 400; letter-spacing: -0.035em; }
  .fc-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 48px; flex-wrap: wrap; margin-top: clamp(48px, 6vw, 96px); padding-top: 32px; border-top: 1px solid var(--line); }
  .fc-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .fc-btn { min-height: 68px; padding: 0 34px; font-size: 0.875rem; }
  .fc-info { display: flex; gap: clamp(24px, 4vw, 56px); margin: 0; flex-wrap: wrap; }
  .fc-info dt { opacity: 0.5; margin-bottom: 8px; }
  .fc-info dd { margin: 0; font-weight: 700; display: grid; }
  .fc-info a:hover { color: var(--yellow); }
  @media (max-width: 600px) { .fc-title { font-size: clamp(2.4rem, 11.5vw, 4.4rem); } .fc-btn { width: 100%; } .fc-ctas { width: 100%; } }
</style>
