---
/**
 * Slider Antes | Depois. Mouse, arraste, toque e teclado (←/→, Home, End).
 * Alça em forma de régua — a ferramenta de quem mede antes de mexer.
 */
import Frame from '@/components/ui/Frame.astro';
import type { Art } from '@/utils/types';

interface Props {
  before?: string;
  after?: string;
  beforeAlt?: string;
  afterAlt?: string;
  beforeArt?: Art;
  afterArt?: Art;
  ratio?: string;
  id?: string;
}
const {
  before, after,
  beforeAlt = 'Móvel antes da intervenção da ReCriarte',
  afterAlt = 'O mesmo móvel depois da intervenção da ReCriarte',
  beforeArt = { kind: 'planejado', mode: 'worn' },
  afterArt = { kind: 'planejado', mode: 'new' },
  ratio = '16/10',
  id = 'ba',
} = Astro.props;
---

<div class="ba" style={`aspect-ratio:${ratio}`} data-ba={id}>
  <div class="ba-layer ba-after">
    <Frame photo={after} alt={afterAlt} art={afterArt} tone="white" bare sizes="(min-width: 1000px) 80vw, 100vw" />
  </div>
  <div class="ba-layer ba-before" data-ba-before>
    <Frame photo={before} alt={beforeAlt} art={beforeArt} tone="mist" bare sizes="(min-width: 1000px) 80vw, 100vw" />
  </div>

  <span class="ba-tag ba-tag--b tech" aria-hidden="true">Antes</span>
  <span class="ba-tag ba-tag--a tech" aria-hidden="true">Depois</span>

  <div
    class="ba-handle"
    role="slider"
    tabindex="0"
    aria-label="Comparar antes e depois"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    aria-valuetext="50% antes, 50% depois"
    data-ba-handle
  >
    <span class="ba-rule" aria-hidden="true"></span>
    <span class="ba-knob" aria-hidden="true">
      <svg viewBox="0 0 24 12"><path d="M7 1 2 6l5 5M17 1l5 5-5 5" /></svg>
    </span>
    <span class="ba-val tech" aria-hidden="true" data-ba-val>50</span>
  </div>
</div>

<style>
  .ba {
    --pos: 50%;
    position: relative; width: 100%;
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
    cursor: ew-resize;
    background: var(--mist);
  }
  .ba-layer { position: absolute; inset: 0; }
  .ba-layer :global(.frame) { width: 100%; height: 100%; }
  .ba-layer :global(.frame-draw) { width: min(78%, 820px); }
  .ba-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }

  .ba-tag { position: absolute; top: 20px; z-index: 3; padding: 8px 12px; transition: opacity 0.4s; }
  .ba-tag--b { left: 20px; background: var(--navy); color: var(--white); opacity: var(--b-op, 1); }
  .ba-tag--a { right: 20px; background: var(--yellow); color: var(--navy); opacity: var(--a-op, 1); }

  .ba-handle {
    position: absolute; top: 0; bottom: 0; left: var(--pos); z-index: 4;
    width: 48px; margin-left: -24px;
    display: grid; place-items: center;
    outline: none;
  }
  .ba-rule {
    position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px;
    background: var(--navy);
  }
  .ba-rule::after { /* marcas de régua */
    content: ''; position: absolute; top: 0; bottom: 0; left: 2px; width: 8px;
    background: repeating-linear-gradient(to bottom, var(--navy) 0 1.5px, transparent 1.5px 16px);
    opacity: 0.7;
  }
  .ba-knob {
    position: relative; width: 56px; height: 56px;
    background: var(--yellow);
    display: grid; place-items: center;
    transition: transform 0.4s var(--ease-out);
  }
  .ba-knob svg { width: 26px; fill: none; stroke: var(--navy); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ba:hover .ba-knob, .ba-handle:focus-visible .ba-knob, .ba.is-drag .ba-knob { transform: scale(1.1) rotate(90deg); }
  .ba-handle:focus-visible .ba-knob { box-shadow: 0 0 0 3px var(--navy), 0 0 0 6px var(--yellow); }
  .ba-val { position: absolute; bottom: 20px; left: 50%; transform: translateX(8px); background: var(--navy); color: var(--white); padding: 4px 8px; font-variant-numeric: tabular-nums; }
  .ba-val::after { content: '%'; }
</style>

<script>
  import { track, trackOnce } from '@/utils/track';
  import { motionOn } from '@/scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((root) => {
    const handle = root.querySelector<HTMLElement>('[data-ba-handle]')!;
    const val = root.querySelector<HTMLElement>('[data-ba-val]')!;
    let pos = 50;
    let interacted = false;

    const set = (p: number) => {
      pos = Math.min(100, Math.max(0, p));
      root.style.setProperty('--pos', `${pos}%`);
      root.style.setProperty('--b-op', String(Math.min(1, pos / 15)));
      root.style.setProperty('--a-op', String(Math.min(1, (100 - pos) / 15)));
      const r = Math.round(pos);
      val.textContent = String(r);
      handle.setAttribute('aria-valuenow', String(r));
      handle.setAttribute('aria-valuetext', `${r}% antes, ${100 - r}% depois`);
    };
    const mark = () => {
      if (interacted) return;
      interacted = true;
      trackOnce('before_after_interacted', { id: root.dataset.ba ?? '' });
    };
    const fromEvent = (e: PointerEvent) => {
      const r = root.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };

    root.addEventListener('pointerdown', (e) => {
      root.setPointerCapture(e.pointerId);
      root.classList.add('is-drag');
      fromEvent(e);
      mark();
    });
    root.addEventListener('pointermove', (e) => {
      // mouse: segue o cursor; toque: só enquanto arrasta
      if (root.classList.contains('is-drag') || e.pointerType === 'mouse') { fromEvent(e); if (e.pointerType === 'mouse') mark(); }
    });
    const end = () => root.classList.remove('is-drag');
    root.addEventListener('pointerup', end);
    root.addEventListener('pointercancel', end);

    handle.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 10 : 2;
      const map: Record<string, number> = { ArrowLeft: pos - step, ArrowDown: pos - step, ArrowRight: pos + step, ArrowUp: pos + step, Home: 0, End: 100 };
      if (e.key in map) { e.preventDefault(); set(map[e.key]); mark(); track('before_after_interacted', { via: 'keyboard' }); }
    });

    // Dica de interação: a régua "mede" uma vez quando aparece
    if (motionOn()) {
      new IntersectionObserver((entries, o) => {
        if (!entries[0].isIntersecting) return;
        o.disconnect();
        const seq = [50, 28, 72, 50];
        let t0: number | null = null;
        const dur = 2200;
        const tick = (t: number) => {
          if (interacted) return;
          t0 ??= t;
          const k = Math.min(1, (t - t0) / dur);
          const seg = Math.min(seq.length - 2, Math.floor(k * (seq.length - 1)));
          const local = k * (seq.length - 1) - seg;
          const ease = local < 0.5 ? 4 * local ** 3 : 1 - (-2 * local + 2) ** 3 / 2;
          set(seq[seg] + (seq[seg + 1] - seq[seg]) * ease);
          if (k < 1) requestAnimationFrame(tick);
        };
        setTimeout(() => requestAnimationFrame(tick), 400);
      }, { threshold: 0.6 }).observe(root);
    }
    set(50);
  });
</script>
