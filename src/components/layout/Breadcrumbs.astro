---
export interface Crumb { name: string; href: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---

<nav class="bc" aria-label="Você está em">
  <ol role="list">
    {items.map((c, i) => (
      <li>
        {i < items.length - 1
          ? <a href={c.href}>{c.name}</a>
          : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .bc ol { display: flex; flex-wrap: wrap; gap: 8px; font-size: var(--fs-sm); font-weight: 600; }
  .bc li { display: flex; align-items: center; gap: 8px; }
  .bc li + li::before { content: '/'; opacity: 0.35; }
  .bc a { opacity: 0.6; transition: opacity 0.3s; }
  .bc a:hover { opacity: 1; }
  .bc [aria-current] { color: inherit; }
</style>
