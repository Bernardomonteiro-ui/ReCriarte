---
import '@fontsource-variable/montserrat';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@/styles/global.css';

import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MobileCta from '@/components/whatsapp/MobileCta.astro';
import { company } from '@/config/company';
import { analytics } from '@/config/analytics';
import { localBusiness } from '@/utils/schema';
import { absUrl, withBase } from '@/utils/url';

interface Props {
  title: string;
  description: string;
  /** Imagem OG relativa a /public */
  ogImage?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Página com hero claro/escuro: ajusta o header inicial */
  headerTone?: 'light' | 'dark';
  /** Evento de página de serviço */
  serviceId?: string;
}

const { title, description, ogImage = '/og.png', schema = [], noindex = false, headerTone = 'light', serviceId } = Astro.props;
const site = Astro.site ?? new URL('https://recriarte.com.br');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cleanPath = Astro.url.pathname
  .replace(base ? new RegExp(`^${base}(?=/|$)`) : /^$/, '')
  .replace(/\.html$/, '').replace(/\/?index$/, '').replace(/\/$/, '');
const canonical = absUrl(cleanPath || '/', site);
const fullTitle = title.includes(company.name) ? title : `${title} | ${company.name}`;
const jsonld = [localBusiness(site), ...schema];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="theme-color" content="#0E183B" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absUrl(ogImage, site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ReCriarte — Seu planejado não precisa ser trocado. Precisa ser recriado." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="geo.region" content="BR-PR" />
    <meta name="geo.placename" content="Londrina" />

    {jsonld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>
      // Estados iniciais de animação só quando o motion pode rodar.
      // Rede de segurança: se o JS não iniciar, o conteúdo aparece.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(function () {
          if (!window.__motionReady) document.documentElement.classList.remove('motion');
        }, 3500);
      }
    </script>

    {analytics.gtmId && (
      <script is:inline define:vars={{ id: analytics.gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
      </script>
    )}
    {!analytics.gtmId && analytics.ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4Id}`}></script>
        <script is:inline define:vars={{ id: analytics.ga4Id }}>
          window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}window.gtag=gtag;gtag('js',new Date());gtag('config',id);
        </script>
      </>
    )}
  </head>
  <body data-service={serviceId}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header tone={headerTone} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <MobileCta />
    <div class="cursor-tag" aria-hidden="true" data-cursor><span>VER<br />PROJETO</span></div>

    <script>
      import { initMotion } from '@/scripts/motion';
      import { initCursor } from '@/scripts/cursor';
      import { track } from '@/utils/track';

      initMotion();
      initCursor();

      // Qualquer link de WhatsApp do site
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="wa.me"]');
        if (a) track('whatsapp_clicked', { location: a.dataset.wa ?? 'link' });
      });

      const svc = document.body.dataset.service;
      if (svc) track('service_page_viewed', { service: svc });
    </script>
  </body>
</html>
