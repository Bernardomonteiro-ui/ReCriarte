---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Line from '@/components/motion/Line.astro';
import Manifesto from '@/components/sections/Manifesto.astro';
import Team from '@/components/team/Team.astro';
import Reviews from '@/components/testimonials/Reviews.astro';
import Process from '@/components/process/Process.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { breadcrumbs } from '@/utils/schema';
import { whatsappUrl, messages } from '@/utils/whatsapp';

const site = Astro.site!;
const crumbs = [{ name: 'Início', href: '/' }, { name: 'Sobre', href: '/sobre' }];
const verbs = ['Recupera.', 'Adapta.', 'Transforma.', 'Recria.'];
---

<BaseLayout
  title="Sobre a ReCriarte — manutenção de móveis planejados em Londrina"
  description="A ReCriarte é especializada no móvel planejado que já existe: manutenção, adaptação, montagem e peças sob medida em Londrina — PR."
  schema={[breadcrumbs(site, crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    lead="A ReCriarte não vende móveis. Ela resolve o que já existe — e cuida para que o seu planejado continue funcionando, do jeito que foi pensado ou de um jeito novo."
    art={{ kind: 'planejado', mode: 'line', dims: true }}
    photo="sobre/hero.jpg"
    imageAlt="Desenho técnico de móvel planejado"
    refCode="Elevação técnica"
    ctaLabel="Falar com a ReCriarte"
    ctaHref={whatsappUrl(messages.default)}
  >
    <Fragment slot="title">
      <Line>Especialistas no</Line>
      <Line>móvel que já existe.</Line>
    </Fragment>
  </PageHero>

  <section class="sb" data-theme="navy" aria-label="O que a ReCriarte faz">
    <div class="container">
      <ul class="sb-verbs" role="list">
        {verbs.map((v, i) => (
          <li class:list={[{ 'sb-last': i === verbs.length - 1 }]}>
                        <span class:list={['sb-v', { 'serif hl': i === verbs.length - 1 }]}>{v}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Manifesto />
  <Team />
  <Process />
  <Reviews />
  <FinalCta />
</BaseLayout>

<style>
  .sb { padding-block: clamp(72px, 9vw, 140px); }
  .sb-verbs { display: grid; }
  .sb-verbs li { display: flex; align-items: baseline; gap: 20px; border-bottom: 1px solid var(--line); padding: 8px 0; }
  .sb-v { font-size: var(--fs-3xl); font-weight: 900; letter-spacing: -0.05em; line-height: 1.05; }
  .sb-v.serif { font-weight: 400; letter-spacing: -0.03em; }
  .sb-verbs .index-num { width: 40px; flex: none; }
</style>
