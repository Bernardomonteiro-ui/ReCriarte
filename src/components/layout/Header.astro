---
import Logo from './Logo.astro';
import { nav } from '@/data/content';
import { services } from '@/data/services';
import { company } from '@/config/company';
import { whatsappUrl, messages } from '@/utils/whatsapp';

interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;
---

<header class:list={['hdr', `hdr--${tone}`]} data-header>
  <div class="hdr-in container">
    <a href="/" class="hdr-logo" aria-label="ReCriarte — página inicial"><Logo /></a>

    <nav class="hdr-nav" aria-label="Principal">
      <ul role="list">
        {nav.map((n) => (
          <li><a href={n.href}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="/orcamento" class="btn btn--sm hdr-cta">Pedir orçamento <span class="arrow" aria-hidden="true">→</span></a>

    <button class="hdr-burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu" data-menu-btn>
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" data-theme="navy" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
  <div class="menu-in container">
    <nav aria-label="Menu principal">
      <ul role="list" class="menu-main">
        {[{ label: 'Início', href: '/' }, ...nav, { label: 'Orçamento', href: '/orcamento' }].map((n) => (
          <li class="menu-item">
            <a href={n.href} data-menu-link><span class="menu-lbl">{n.label}</span></a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="menu-foot menu-item">
      <p class="tech">Serviços</p>
      <ul role="list" class="menu-svc">
        {services.map((s) => <li><a href={s.href} data-menu-link>{s.title}</a></li>)}
      </ul>
      <a class="btn btn--block" href={whatsappUrl(messages.default)} target="_blank" rel="noopener" data-wa="menu">
        Falar no WhatsApp
      </a>
      <p class="tech menu-city">{company.cityLabel}</p>
    </div>
  </div>
</div>

<style>
  .hdr {
    position: fixed; inset: 0 0 auto; z-index: 80;
    height: var(--header-h);
    color: var(--navy);
    transition: height 0.5s var(--ease-out), background-color 0.5s, color 0.5s, box-shadow 0.5s;
  }
  .hdr--dark { color: var(--white); }
  .hdr.is-scrolled {
    --header-h: 68px;
    background: var(--white);
    color: var(--navy);
    box-shadow: 0 1px 0 var(--line);
  }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr { transition: transform 0.5s var(--ease-out), height 0.5s var(--ease-out), background-color 0.5s, color 0.5s, box-shadow 0.5s; }
  .hdr.menu-open { color: var(--white); background: transparent; box-shadow: none; transform: none; }

  .hdr-in { height: 100%; display: flex; align-items: center; gap: 32px; }
  .hdr-logo { margin-right: auto; position: relative; z-index: 2; }

  .hdr-nav ul { display: flex; gap: clamp(20px, 2.6vw, 40px); }
  .hdr-nav a {
    position: relative; display: inline-flex; align-items: baseline; gap: 6px;
    font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0.02em;
    padding-block: 8px;
  }
  .hdr-nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 2px;
    background: var(--yellow); transform: scaleX(0); transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }
  .hdr-nav a:hover::after { transform: scaleX(1); }

  .hdr-burger { display: none; position: relative; z-index: 2; width: 44px; height: 44px; }
  .hdr-burger span {
    position: absolute; left: 10px; right: 10px; height: 2px; background: currentColor;
    transition: transform 0.5s var(--ease-out), top 0.5s var(--ease-out);
  }
  .hdr-burger span:first-child { top: 17px; }
  .hdr-burger span:last-child { top: 26px; right: 16px; }
  .hdr-burger[aria-expanded='true'] span:first-child { top: 21px; transform: rotate(45deg); }
  .hdr-burger[aria-expanded='true'] span:last-child { top: 21px; right: 10px; transform: rotate(-45deg); }

  @media (max-width: 900px) {
    .hdr-nav { display: none; }
    .hdr-burger { display: block; }
    .hdr-cta { display: none; }
  }

  /* ---------- Menu fullscreen ---------- */
  .menu {
    position: fixed; inset: 0; z-index: 70;
    background: var(--navy);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s var(--ease-in-out);
    overflow-y: auto;
  }
  .menu.is-open { clip-path: inset(0 0 0% 0); }
  .menu-in {
    min-height: 100%;
    padding-top: calc(var(--header-h) + 32px); padding-bottom: 32px;
    display: grid; align-content: space-between; gap: 48px;
  }
  .menu-main { display: grid; gap: 4px; }
  .menu-main a {
    display: flex; align-items: baseline; gap: 16px;
    font-size: clamp(2.2rem, 9vw, 4rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.15;
  }
  .menu-main a:hover .menu-lbl, .menu-main a:focus-visible .menu-lbl { color: var(--yellow); font-family: var(--serif); font-style: italic; font-weight: 400; }
  .menu-foot { display: grid; gap: 18px; border-top: 1px solid var(--line); padding-top: 24px; }
  .menu-svc { display: flex; flex-wrap: wrap; gap: 8px 20px; font-weight: 600; font-size: var(--fs-sm); }
  .menu-city { opacity: 0.6; }
  .menu-item { opacity: 0; transform: translateY(24px); transition: opacity 0.6s, transform 0.8s var(--ease-out); }
  .menu.is-open .menu-item { opacity: 1; transform: none; }
  .menu.is-open .menu-item:nth-child(1) { transition-delay: 0.25s; }
  .menu.is-open .menu-item:nth-child(2) { transition-delay: 0.3s; }
  .menu.is-open .menu-item:nth-child(3) { transition-delay: 0.35s; }
  .menu.is-open .menu-item:nth-child(4) { transition-delay: 0.4s; }
  .menu.is-open .menu-item:nth-child(5) { transition-delay: 0.45s; }
  .menu.is-open .menu-item:nth-child(6) { transition-delay: 0.5s; }
  .menu.is-open .menu-foot { transition-delay: 0.55s; }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  // Header: reduz e ganha fundo ao rolar; esconde ao descer, volta ao subir.
  let lastY = 0;
  const onScroll = () => {
    const y = window.scrollY;
    hdr.classList.toggle('is-scrolled', y > 40);
    hdr.classList.toggle('is-hidden', y > 600 && y > lastY + 4 && !menu.classList.contains('is-open'));
    if (y < lastY - 4 || y < 600) hdr.classList.remove('is-hidden');
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Menu mobile
  let lastFocus: Element | null = null;
  const open = () => {
    lastFocus = document.activeElement;
    menu.hidden = false;
    requestAnimationFrame(() => menu.classList.add('is-open'));
    hdr.classList.add('menu-open');
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', 'Fechar menu');
    document.body.style.overflow = 'hidden';
    menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
  };
  const close = () => {
    menu.classList.remove('is-open');
    hdr.classList.remove('menu-open');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Abrir menu');
    document.body.style.overflow = '';
    setTimeout(() => { if (!menu.classList.contains('is-open')) menu.hidden = true; }, 800);
    (lastFocus as HTMLElement | null)?.focus?.();
  };
  btn.addEventListener('click', () => (menu.classList.contains('is-open') ? close() : open()));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.classList.contains('is-open')) close();
    // foco preso entre o botão e o menu
    if (e.key === 'Tab' && menu.classList.contains('is-open')) {
      const f = [btn, ...menu.querySelectorAll<HTMLElement>('a, button')];
      const i = f.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); }
      else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); }
    }
  });
</script>
